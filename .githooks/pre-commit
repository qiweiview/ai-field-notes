#!/usr/bin/env bash
# ==============================================================================
# Git Pre-commit Hook for ai-field-notes (Public Repository)
# Blocks accidental commit of sensitive credentials, keys, and private files.
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit security checks for public repository..."

# 1. Check for forbidden file names/extensions in staged files
FORBIDDEN_PATTERNS=(
    "\.env$"
    "\.env\..*$"
    "\.pem$"
    "\.key$"
    "\.p12$"
    "\.pfx$"
    "id_rsa"
    "id_ed25519"
    "credentials\.json$"
    "client_secret.*\.json$"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FAILED=0

for FILE in $STAGED_FILES; do
    # Allow .env.example
    if [ "$FILE" = ".env.example" ]; then
        continue
    fi

    for PATTERN in "${FORBIDDEN_PATTERNS[@]}"; do
        if echo "$FILE" | grep -Eq "$PATTERN"; then
            echo -e "${RED}[ERROR] Forbidden file staged:${NC} $FILE"
            echo -e "        This is a public repository. Secrets & keys must never be committed."
            FAILED=1
        fi
    done
done

# 2. Check for sensitive strings/tokens in diff content
# Only inspect added lines (starts with '+', excluding '+++')
ADDED_DIFF=$(git diff --cached -U0 | grep '^[+]' | grep -v '^[+][+][+]' || true)

if [ -n "$ADDED_DIFF" ]; then
    # Pattern checks
    SENSITIVE_REGEXES=(
        "-----BEGIN (RSA|OPENSSH|DSA|EC|PGP)? ?PRIVATE KEY-----"
        "AKIA[0-9A-Z]{16}"
        "ghp_[a-zA-Z0-9]{36}"
        "github_pat_[a-zA-Z0-9_]{82}"
        "sk-[a-zA-Z0-9]{20,}"
        "sk-proj-[a-zA-Z0-9_-]{20,}"
        "xox[baprs]-[0-9a-zA-Z-]{10,}"
    )

    for REGEX in "${SENSITIVE_REGEXES[@]}"; do
        MATCH=$(echo "$ADDED_DIFF" | grep -Ei -e "$REGEX" || true)
        if [ -n "$MATCH" ]; then
            # Ignore false-positives containing mock/placeholder/dummy
            FILTERED_MATCH=$(echo "$MATCH" | grep -Evi -e "(dummy|mock|placeholder|example|your_)" || true)
            if [ -n "$FILTERED_MATCH" ]; then
                echo -e "${RED}[ERROR] Detected sensitive token pattern in staged changes:${NC}"
                echo "$FILTERED_MATCH" | head -n 3
                echo -e "${YELLOW}Hint: If this is a mock test string, use 'mock_' or 'dummy_' prefix.${NC}"
                FAILED=1
            fi
        fi
    done
fi

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}❌ Commit aborted due to sensitive data security violations.${NC}"
    echo -e "   Please refer to AGENTS.md and SECURITY.md for instructions."
    exit 1
fi

echo -e "${GREEN}✅ Pre-commit security checks passed.${NC}"
exit 0
