# ==============================================================================
# Public Repository Environment Template
# 
# ⚠️ WARNING: THIS REPOSITORY IS PUBLIC. NEVER COMMIT REAL CREDENTIALS OR SECRETS!
# Copy this file to '.env' for local development only (which is ignored by git).
# Use placeholder values here.
# ==============================================================================

# LLM / AI API Keys (Placeholders ONLY)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Service Endpoints & Database (Placeholders ONLY)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379

# Application Settings
APP_ENV=development
LOG_LEVEL=info
